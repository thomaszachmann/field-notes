# source this (do not execute) before tofu; adapt to your keychain
export VAULT_ADDR="https://bao.example.internal"
export BAO_ADDR="$VAULT_ADDR"
read -rs -p "State passphrase: " TF_VAR_state_passphrase; echo
read -rs -p "PostgreSQL password of role openbao: " TF_VAR_postgres_openbao_password; echo
read -rs -p "Keycloak client secret: " TF_VAR_keycloak_client_secret; echo
export TF_VAR_state_passphrase TF_VAR_postgres_openbao_password TF_VAR_keycloak_client_secret
export TF_VAR_pki_root_ca_pem="$(bao read -field=certificate pki/cert/ca)"
